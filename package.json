{
  "name": "nunoxdesk",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "set NODE_ENV=test&& jest",
    "test:e2e": "playwright test",
    "start": "electron electron/main.js",
    "dev": "electron-reload electron/main.js",
    "build": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.nunoxdesk.app",
    "productName": "NunoxDesk",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "files": [
      "electron/**/*",
      "controllers/**/*",
      "database/**/*",
      "public/**/*",
      "views/**/*"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nuno-Hadianto/NunoxDesk.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Nuno-Hadianto/NunoxDesk/issues"
  },
  "homepage": "https://github.com/Nuno-Hadianto/NunoxDesk#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-reload": "^2.0.0-alpha.1",
    "jest": "^30.4.2"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
